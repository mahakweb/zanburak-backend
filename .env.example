APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=zanburak
DB_USERNAME=postgres
DB_PASSWORD=Milad@4970
DB_SSLMODE=prefer
DB_SEARCH_PATH=public

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Messenger (self-hosted realtime, no Reverb/Pusher)
MESSENGER_REDIS=false
MESSENGER_STREAM_TTL=30
MESSENGER_STREAM_POLL_MS=1000
MESSENGER_STREAM_HEARTBEAT=15
MESSENGER_STREAM_REDIS_BLOCK=5
MESSENGER_TYPING_THROTTLE=2
MESSENGER_EVENT_RETENTION_HOURS=48

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Admin mail inbox (cPanel: IMAP mail.zanburak.ir:993 SSL, SMTP :465 SSL)
MAIL_INBOX_IMAP_HOST=mail.zanburak.ir
MAIL_INBOX_IMAP_PORT=993
MAIL_INBOX_IMAP_ENCRYPTION=ssl
MAIL_INBOX_IMAP_VALIDATE_CERT=true
MAIL_INBOX_DEFAULT_PASSWORD=

# Per-mailbox overrides (username defaults to the address)
# MAIL_INBOX_ADMIN_PASSWORD=
# MAIL_INBOX_SUPPORT_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Laravel Reverb Configuration
REVERB_APP_ID=zanburak-app
REVERB_APP_KEY=zanburak-key
REVERB_APP_SECRET=zanburak-secret
REVERB_HOST=localhost
REVERB_PORT=6001
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=6001

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
