{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "cviebrock/eloquent-sluggable": "^11.0",
        "cviebrock/eloquent-taggable": "^11.0",
        "endroid/qr-code": "^6.0",
        "ghasedak/php": "dev-master",
        "guzzlehttp/guzzle": "^7.2",
        "http-interop/http-factory-guzzle": "^1.2",
        "ip2location/ip2location-laravel": "^1.3",
        "jenssegers/agent": "^2.6",
        "laravel-interaction/bookmark": "^3.4",
        "laravel/fortify": "^1.24",
        "laravel/framework": "^11.0",
        "laravel/reverb": "^1.7",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^10.0",
        "laravel/socialite": "^5.8",
        "laravel/tinker": "^2.9",
        "league/flysystem-ftp": "^3.0",
        "league/flysystem-sftp-v3": "^3.0",
        "mehradsadeghi/laravel-filter-querystring": "^1.1",
        "meilisearch/meilisearch-php": "^1.16",
        "melipayamak/php": "1.0.0",
        "morilog/jalali": "^3.5",
        "overtrue/laravel-follow": "^5.3",
        "overtrue/laravel-subscribe": "^4.1",
        "pbmedia/laravel-ffmpeg": "^8.2",
        "predis/predis": "^3.5",
        "pusher/pusher-php-server": "^7.2",
        "spatie/image": "^3.9",
        "webklex/php-imap": "^6.2",
        "ybazli/faker": "^1.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^10.5",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "files": [
            "app/helpers.php",
            "app/Http/CustomHelpers/ActiveRoute.php",
            "app/Http/CustomHelpers/getMessageZarinpal.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
