{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.0.2",
        "alexusmai/laravel-file-manager": "^3.0",
        "barryvdh/laravel-dompdf": "^2.2",
        "beyondcode/laravel-websockets": "^1.14",
        "bumbummen99/shoppingcart": "^4.2",
        "cviebrock/eloquent-sluggable": "^9.0",
        "cviebrock/eloquent-taggable": "^9.0",
        "fruitcake/laravel-cors": "^3.0",
        "ghasedak/php": "dev-master",
        "guzzlehttp/guzzle": "^7.2",
        "http-interop/http-factory-guzzle": "^1.2",
        "ip2location/ip2location-laravel": "^1.3",
        "jenssegers/agent": "^2.6",
        "laravel-interaction/bookmark": "^3.1",
        "laravel/fortify": "^1.19",
        "laravel/framework": "^9.19",
        "laravel/sanctum": "^2.14.1",
        "laravel/scout": "^10.2",
        "laravel/socialite": "^5.6",
        "laravel/tinker": "^2.7",
        "laravel/ui": "^4.0",
        "league/flysystem-ftp": "3.0",
        "league/flysystem-sftp-v3": "3.0",
        "mehradsadeghi/laravel-filter-querystring": "^1.1",
        "meilisearch/meilisearch-php": "^1.16",
        "melipayamak/php": "1.0.0",
        "morilog/jalali": "3.*",
        "overtrue/laravel-follow": "^5.0",
        "overtrue/laravel-subscribe": "^4.1",
        "pbmedia/laravel-ffmpeg": "^8.2",
        "pusher/pusher-php-server": "^7.2",
        "realrashid/sweet-alert": "^6.0",
        "shetabit/payment": "^4.3",
        "spatie/image": "^2.2",
        "ybazli/faker": "^1.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.1",
        "phpunit/phpunit": "^9.5.10",
        "spatie/laravel-ignition": "^1.0"
    },
    "autoload": {
        "files": [
            "app/helpers.php",
            "app/Http/CustomHelpers/ActiveRoute.php",
            "app/Http/CustomHelpers/getMessageZarinpal.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
